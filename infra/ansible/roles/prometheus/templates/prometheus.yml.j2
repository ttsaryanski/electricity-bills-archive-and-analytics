global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - "127.0.0.1:9090"

  - job_name: powertrack_app
    scheme: http
    metrics_path: /metrics
    static_configs:
      - targets:
          - "{{ prometheus_app_target }}"

  - job_name: node_exporter
    static_configs:
      - targets:
          - "{{ node_exporter_target }}"